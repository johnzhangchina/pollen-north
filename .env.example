# 服务端口
PORT=8787
# 抓取间隔（小时）；医院数据每天早上 08:00 更新一次，一天抓一次即可；迟报会在次日抓 7 天历史时补齐
SCRAPE_INTERVAL_HOURS=24
# 风场：区域 [minLon,minLat,maxLon,maxLat]、网格步长（度）、刷新间隔（小时）
# 全国 1 度 ≈ 2300 个点，一天刷一次即可（风场自带 3 天预报），远在 Open-Meteo 免费额度（1 万/天）之内
WIND_BBOX=73,18,135,54
WIND_STEP_DEG=1
WIND_REFRESH_HOURS=24
# best_match | cma_grapes_global | gfs_seamless | ecmwf_ifs025 ...
WIND_MODEL=best_match
# 设置后可用 POST /api/admin/scrape?token=... 手动触发
ADMIN_TOKEN=
# 前端底图：amap（默认，高德中文，GCJ-02，免 key，个人研究用）| tianditu（官方中文 WGS84，需 VITE_TIANDITU_KEY，上线首选）| osm | esri | carto（需 key）
VITE_TILE_PRESET=amap
VITE_TIANDITU_KEY=

# 植被/土地覆盖聚合格子（度）与并发读取数；数据来自 Copernicus LC100 2019，npm run landcover 生成一次即可
LANDCOVER_STEP_DEG=0.1
LANDCOVER_CONCURRENCY=1
# Zenodo 每分钟约 130 次请求上限，保守用 100
LANDCOVER_RPM=60

# 纯静态部署（Cloudflare Pages 等）构建前端时打开：接口改读 /api/xxx.json（npm run export 生成）
# VITE_STATIC_API=1
# 接口挂在别的域名时的前缀，默认同源
# VITE_API_BASE=
