{
  "name": "pollen-north",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "北方花粉风图：站点等级 + 风场粒子 + 扩散趋势推算（MVP）",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "scrape": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.ts scrape",
    "wind": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.ts wind",
    "boundaries": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.ts boundaries",
    "landcover": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.ts landcover",
    "export": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.ts export",
    "build:static": "VITE_STATIC_API=1 vite build --config vite.config.ts && npm run export"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "geotiff": "^3.0.5",
    "hono": "^4.7.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
